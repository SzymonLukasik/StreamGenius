# StreamGenius — Environment Variables

# Fishjam (sign up at https://fishjam.io/app)
FISHJAM_ID=
FISHJAM_TOKEN=

# Google Gemini (hackathon credits)
GOOGLE_API_KEY=

# YouTube Data API v3 (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# Google Custom Search — optional (https://programmablesearchengine.google.com)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Server
PORT=3001

# Mock mode — sends fake overlay proposals without any API keys
# Use this for frontend development: MOCK_MODE=true
MOCK_MODE=true
