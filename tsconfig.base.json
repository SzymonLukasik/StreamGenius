{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@streamgenius/shared": ["./packages/shared/src"],
      "@streamgenius/backend": ["./packages/backend/src"],
      "@streamgenius/frontend": ["./packages/frontend/src"],
      "@streamgenius/overlays": ["./packages/overlays/src"]
    }
  }
}
